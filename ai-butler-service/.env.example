APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=["http://127.0.0.1:5173"]
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_SECONDS=1800
AUTH_REFRESH_TOKEN_SECONDS=2592000
STREAM_TICKET_SECRET=replace-with-at-least-32-random-characters
STREAM_TICKET_SECONDS=600
APP_DATABASE_URL=postgresql+psycopg://butler_app:butler_app@127.0.0.1:5432/butler_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://butler_migrator:butler_migrator@127.0.0.1:5432/butler_dev
LANGGRAPH_DATABASE_URL=postgresql://butler_app:butler_app@127.0.0.1:5432/butler_langgraph_dev
LANGGRAPH_MIGRATION_DATABASE_URL=postgresql://butler_migrator:butler_migrator@127.0.0.1:5432/butler_langgraph_dev
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=ai_butler_knowledge
SEARCH_PROVIDER=fake
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_QUERIES=3
SEARCH_MAX_RESULTS=5
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
CHAT_MODEL=fake-chat-v1
EMBEDDING_MODEL=fake-embedding-v1
EMBEDDING_DIMENSIONS=8
WECHAT_AUTH_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_PATH=./local-storage
PUBLIC_BASE_URL=http://127.0.0.1:8000
OFFICIAL_SOURCE_DOMAINS=[]
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SSE_HEARTBEAT_SECONDS=15
SSE_POLL_INTERVAL_MS=250
WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_SECONDS=600
CONTEXT_WINDOW_TOKENS=16000
CONTEXT_SOFT_LIMIT_RATIO=0.70
CONTEXT_HARD_LIMIT_RATIO=0.85
EVENT_RETENTION_DAYS=7
CHECKPOINT_RETENTION_DAYS=7
LOG_LEVEL=INFO
TRACING_ENABLED=false
